# ==========================================================
# Konfigurasi lingkungan Vantrex Classroom
# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN commit berkas .env yang berisi kredensial asli.
# ==========================================================

# Nama aplikasi yang ditampilkan di navbar dan judul halaman (opsional)
# Default: Vantrex Classroom
APP_NAME=Vantrex Classroom

# Alamat email pemilik/owner aplikasi (wajib). Email ini otomatis
# diberi peran "owner" saat pertama kali masuk dengan Google.
OWNER_EMAIL=jckoomhardika21@gmail.com

# Rahasia sesi NextAuth (wajib). Buat dengan: npx auth secret
AUTH_SECRET=Kx9mP2vR8qT4nW7zY1aB6cD3eF5gH0jLkM9pQ2sV4xA=

# Kredensial Google OAuth (wajib untuk login Google).
# Dapatkan di Google Cloud Console > Credentials.
AUTH_GOOGLE_ID=966289720702-sli0agjuc9geukordih3ns6ubdmeeq9i.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=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

# URL situs aplikasi (opsional). Jika kosong, NextAuth memakai
# NEXTAUTH_URL atau mendeteksi otomatis dari request.
AUTH_URL=https://van-classroom.my.id

# Kredensial Upstash Redis REST (wajib).
# Ambil dari dashboard Upstash > Database > REST API.
UPSTASH_REDIS_REST_URL=https://verified-drum-134059.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAgurAAIgcDJlYjEzZjRmZDdjOTA0ZGYyOTkyNzY0YzI0NTIwMGI2MQ

# Token Vercel Blob (wajib untuk unggahan berkas).
# Token ini HANYA dipakai di sisi server, jangan pernah diekspos ke browser.
BLOB_READ_WRITE_TOKEN=
